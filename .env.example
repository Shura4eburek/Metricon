# Copy this file to .env for local development
# On Railway — set these in the dashboard (Variables tab)

# Required in production
DJANGO_SECRET_KEY=your-long-random-secret-key-here

# Set automatically by Railway PostgreSQL plugin — don't set manually on Railway
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Local dev only (production uses Railway's auto-detection)
DJANGO_DEBUG=True

# Production: comma-separated list of allowed hostnames
# DJANGO_ALLOWED_HOSTS=your-app.up.railway.app

# Optional
# DJANGO_LOG_LEVEL=WARNING
